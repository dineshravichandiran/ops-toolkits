#!/usr/bin/env bash
#
# upgrade-preflight - answers one question before a deployment or
# upgrade: is this host actually ready?
#
# Companion to deploy-validator: upgrade-preflight runs BEFORE the change
# (disk space, backup freshness, current version, service state, no
# stuck processes) and deploy-validator runs AFTER it (did the change
# land correctly). Same manifest-driven design, same report()/exit-code
# shape, so the two read as a matched pair -- see README.md.
#
# Checks and reports only. Never modifies, restarts, backs up, or deletes
# anything on the host it's checking.
#
# Exit codes:
#   0   GO      -- every item in the manifest passed
#   1   NO-GO   -- one or more items failed
#   2   manifest or usage error (bad path, malformed manifest, etc.)
#   3   internal error (missing dependency, cannot source libraries)
#
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"

# shellcheck source=../lib/common.sh
source "${ROOT_DIR}/lib/common.sh" || { echo "cannot source lib/common.sh" >&2; exit 3; }
# shellcheck source=../lib/manifest.sh
source "${ROOT_DIR}/lib/manifest.sh" || die "cannot source lib/manifest.sh"
# shellcheck source=../lib/checks.sh
source "${ROOT_DIR}/lib/checks.sh" || die "cannot source lib/checks.sh"

MANIFEST_FILE=""
STRICT=false
OUTPUT_MODE="text"

usage() {
  cat <<'EOF'
Usage: upgrade-preflight --manifest FILE [OPTIONS]

  --manifest FILE   Manifest to validate against (YAML or JSON). Required.
  --strict          Stop and report NO-GO on the first failed check.
                     Default mode checks every item and reports all
                     failures together.
  --json            Emit a machine-readable JSON summary instead of text.
  -h, --help        Show this help.

Exit codes:
  0  GO (all checks passed)
  1  NO-GO (one or more checks failed)
  2  manifest or usage error
  3  internal error

Examples:
  # Full picture: every failure, not just the first
  upgrade-preflight --manifest release-3.4.0.yaml

  # Gate a change-management step: stop at the first problem
  upgrade-preflight --manifest release-3.4.0.yaml --strict

  # Machine-readable output for a pipeline to parse
  upgrade-preflight --manifest release-3.4.0.yaml --json
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --manifest) MANIFEST_FILE="${2:-}"; [[ -z "$MANIFEST_FILE" ]] && { echo "--manifest needs a path" >&2; exit 2; }; shift 2 ;;
    --strict)   STRICT=true; shift ;;
    --json)     OUTPUT_MODE="json"; shift ;;
    -h|--help)  usage; exit 0 ;;
    *)          printf 'unknown option: %s (try --help)\n' "$1" >&2; exit 2 ;;
  esac
done

[[ -n "$MANIFEST_FILE" ]] || { echo "--manifest is required (try --help)" >&2; exit 2; }
[[ -f "$MANIFEST_FILE" ]] || { printf 'manifest not found: %s\n' "$MANIFEST_FILE" >&2; exit 2; }

load_manifest "$MANIFEST_FILE"

if [[ "$OUTPUT_MODE" == "json" ]]; then
  STRICT_REQUESTED="$STRICT"
  STRICT=false

  # Plain redirection, not `out="$(run_all_checks)"`: command substitution
  # forks a subshell, and report()'s updates to ITEMS_TOTAL/ITEMS_PASS/
  # ITEMS_FAIL/FAILURES would be lost when it exits, leaving every counter
  # at zero -- the exact bug deploy-validator's README documents catching
  # in its own --json path.
  run_all_checks >/dev/null

  printf '{\n'
  printf '  "manifest": "%s",\n' "$MANIFEST_FILE"
  printf '  "timestamp": "%s",\n' "$(log_ts)"
  printf '  "items_total": %d,\n' "$ITEMS_TOTAL"
  printf '  "items_pass": %d,\n' "$ITEMS_PASS"
  printf '  "items_fail": %d,\n' "$ITEMS_FAIL"
  printf '  "decision": "%s",\n' "$([[ $ITEMS_FAIL -eq 0 ]] && echo GO || echo NO-GO)"
  printf '  "failures": [\n'
  first_failure=1
  for f in "${FAILURES[@]:-}"; do
    [[ -z "$f" ]] && continue
    name="${f%%: *}"; msg="${f#*: }"
    name="${name//\"/\\\"}"; msg="${msg//\"/\\\"}"
    [[ $first_failure -eq 0 ]] && printf ',\n'
    printf '    {"item": "%s", "message": "%s"}' "$name" "$msg"
    first_failure=0
  done
  printf '\n  ]\n'
  printf '}\n'

  (( ITEMS_FAIL == 0 )) && exit 0 || exit 1
fi

printf '%supgrade-preflight%s  |  manifest: %s  |  %s\n' "$C_BOLD" "$C_RESET" "$MANIFEST_FILE" "$(log_ts)"
[[ "$STRICT" == "true" ]] && printf '%smode: strict (stops on first failure)%s\n' "$C_DIM" "$C_RESET"

run_all_checks
print_summary

(( ITEMS_FAIL == 0 )) && exit 0 || exit 1
